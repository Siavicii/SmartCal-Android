<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <!-- Dynamic Theme-Synced Background Card (Supports all 10 UI styles + One UI 9 Squircle/Glass) -->
    <ImageView
        android:id="@+id/widgetBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Smart Cal Widget Background" />

    <LinearLayout
        android:id="@+id/widgetContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Top Row: Day Number + Date Info + Weather Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widgetDayNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۱"
                android:textSize="38sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#1B6EF3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/widgetMonthYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="آذر ۱۴۰۵"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/widgetSubDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="یکشنبه • 22 Nov 2026"
                    android:textSize="11.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#64748B" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widgetWeatherWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/widgetWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛅ ۱۸°"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/widgetCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تهران"
                    android:textSize="10.5sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Summary Row (Today's Events / Notes) -->
        <TextView
            android:id="@+id/widgetSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تقویم هوشمند جامع Smart Cal"
            android:textSize="11.5sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#475569" />

    </LinearLayout>
</FrameLayout>
